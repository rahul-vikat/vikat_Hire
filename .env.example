# VikatHire application
VIKATHIRE_APP_NAME=VikatHire API
VIKATHIRE_ENVIRONMENT=development
VIKATHIRE_LOG_LEVEL=INFO

# PostgreSQL is required for the LangGraph checkpoint saver and screening-ID registry.
# Use a PostgreSQL URI accepted by psycopg, e.g. postgresql://user:password@localhost:5432/vikathire
VIKATHIRE_DATABASE_URL=
VIKATHIRE_POSTGRES_POOL_MIN_SIZE=1
VIKATHIRE_POSTGRES_POOL_MAX_SIZE=10

# Required provider configuration (supply secrets through your local environment).
VIKATHIRE_APIFY_API_TOKEN=
VIKATHIRE_APIFY_LINKEDIN_ACTOR_ID=
VIKATHIRE_GROQ_API_KEY=
VIKATHIRE_GROQ_MODEL=
VIKATHIRE_GROQ_TEMPERATURE=0.1
VIKATHIRE_GROQ_MAX_TOKENS=4096

# Optional GitHub API token. Public resources can be fetched without it;
# authenticated requests provide GitHub's higher API rate limits.
VIKATHIRE_GITHUB_API_TOKEN=

# Deterministic JD-classification settings. Supply the approved indicator vocabulary.
VIKATHIRE_JD_TECHNICAL_INDICATORS=
VIKATHIRE_JD_NON_TECHNICAL_INDICATORS=
VIKATHIRE_JD_CLASSIFICATION_CONFIGURATION_REF=

# Existing mandatory policy-gate configuration; values must reflect the approved policy.
VIKATHIRE_POLICY_CONFIGURATION_REF=
VIKATHIRE_POLICY_CERTIFICATION_PRESENT=
VIKATHIRE_POLICY_EDUCATION_PRESENT=
VIKATHIRE_POLICY_LOCATION_PRESENT=
VIKATHIRE_POLICY_AVAILABILITY_PRESENT=

# Operational bounds
VIKATHIRE_API_MAX_REQUEST_BYTES=20971520
VIKATHIRE_NETWORK_TIMEOUT_SECONDS=30
VIKATHIRE_APIFY_TIMEOUT_SECONDS=60
VIKATHIRE_APIFY_POLL_INTERVAL_SECONDS=1
